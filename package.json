{
  "name": "property-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run deps:check && vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-previews": "bash scripts/check-previews.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "deps:check": "bash scripts/check-deps.sh",
    "prepare": "husky",
    "postinstall": "node scripts/write-deps-marker.mjs",
    "check-supply-chain": "node scripts/check-supply-chain.mjs",
    "audit:signatures": "bash scripts/audit-signatures.sh"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.3",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/**/*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write"
    ]
  }
}
