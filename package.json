{
  "name": "property-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run deps:check && vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-previews": "bash scripts/check-previews.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "deps:check": "bash scripts/check-deps.sh",
    "prepare": "husky",
    "postinstall": "node scripts/write-deps-marker.mjs",
    "check-supply-chain": "node scripts/check-supply-chain.mjs",
    "audit:signatures": "bash scripts/audit-signatures.sh",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:api": "npm test --prefix api",
    "lint:contract": "npm run lint:contract --prefix api",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@lux-design-system/components-react": "^1.2.3",
    "@lux-design-system/design-tokens": "^2.2.1",
    "@lux-design-system/font": "^1.1.1",
    "lucide-react": "^0.263.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/**/*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
